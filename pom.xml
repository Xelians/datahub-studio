<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.xelians</groupId>
    <artifactId>datahub-studio-parent</artifactId>
    <version>4.3.0</version>
    <packaging>pom</packaging>

    <name>datahub-studio-parent</name>
    <description>Xelians DataHub studio: the SDK to develop workers, and the tooling to audit them</description>
    <url>https://github.com/Xelians/datahub-studio</url>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>Aurelien Bonnafont</name>
            <email>aurelien.bonnafont@xelians.fr</email>
            <organization>Xelians</organization>
            <organizationUrl>https://www.xelians.fr/</organizationUrl>
            <roles>
                <role>Technical Team Leader</role>
            </roles>
        </developer>
        <developer>
            <name>Hamza Bey</name>
            <email>hamza.bey@xelians.fr</email>
            <organization>Xelians</organization>
            <organizationUrl>https://www.xelians.fr/</organizationUrl>
            <roles>
                <role>Developer</role>
            </roles>
        </developer>
        <developer>
            <name>Marine Denis</name>
            <email>marine.denis@xelians.fr</email>
            <organization>Xelians</organization>
            <organizationUrl>https://www.xelians.fr/</organizationUrl>
            <roles>
                <role>Developer</role>
            </roles>
        </developer>
        <developer>
            <name>Mohamed ben abdallah</name>
            <email>mohamed.ben-abdallah@xelians.fr</email>
            <organization>Xelians</organization>
            <organizationUrl>https://www.xelians.fr/</organizationUrl>
            <roles>
                <role>Developer</role>
            </roles>
        </developer>
    </developers>
    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:git://github.com/Xelians/datahub-studio.git</connection>
        <developerConnection>scm:git:ssh://github.com:Xelians/datahub-studio.git</developerConnection>
        <url>https://github.com/Xelians/datahub-studio/tree/main</url>
    </scm>

    <modules>
        <module>datahub-studio</module>
        <module>datahub-studio-worker-parent</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.source.version>3.2.1</maven.source.version>
        <javadoc.source.version>3.4.1</javadoc.source.version>
        <gpg.plugin.version>3.0.1</gpg.plugin.version>
        <central.publishing.version>0.8.0</central.publishing.version>
        <slf4j.version>1.7.32</slf4j.version>
        <jupiter.version>5.8.2</jupiter.version>
    </properties>

    <repositories>
        <repository>
            <id>shibboleth-maven</id>
            <url>https://build.shibboleth.net/nexus/content/repositories/releases/</url>
        </repository>
    </repositories>

    <distributionManagement>
        <snapshotRepository>
            <id>sonatype-nexus-snapshots</id>
            <name>Sonatype Nexus Snapshots</name>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
        <repository>
            <id>sonatype-nexus-staging</id>
            <name>Nexus Release Repository</name>
            <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2</url>
        </repository>
    </distributionManagement>

    <profiles>
        <!--
          Publication on Maven Central: sources, javadoc, GPG signature and the Central bundle.
          Activated by the deploy workflow (mvn -Pxdh-studio-release deploy); a local mvn verify signs nothing.
          datahub-studio-worker-parent does not inherit this POM (see its own xdh-studio-release profile).
        -->
        <profile>
            <id>xdh-studio-release</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven.source.version}</version>
                        <executions>
                            <execution>
                                <id>attach-source</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${javadoc.source.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${gpg.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central.publishing.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
